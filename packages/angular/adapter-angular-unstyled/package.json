{
  "name": "@adapttable/angular-unstyled",
  "version": "0.0.0",
  "private": true,
  "description": "AdaptTable's Angular DataTable with native HTML controls and no styles of its own. Unpublished while it reaches parity with the React kits.",
  "keywords": [
    "angular",
    "data-table",
    "table",
    "unstyled",
    "headless",
    "adapttable"
  ],
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orwa-mahmoud/adapttable.git",
    "directory": "packages/angular/adapter-angular-unstyled"
  },
  "bugs": "https://github.com/orwa-mahmoud/adapttable/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist",
    "README.md"
  ],
  "module": "./dist/fesm2022/adapttable-angular-unstyled.mjs",
  "types": "./dist/types/adapttable-angular-unstyled.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/adapttable-angular-unstyled.d.ts",
      "default": "./dist/fesm2022/adapttable-angular-unstyled.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.build.json && node -e \"require('node:fs').rmSync('dist/package.json')\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0"
  },
  "dependencies": {
    "@adapttable/angular": "0.2.0",
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@adapttable/core": "3.7.0",
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@analogjs/vitest-angular": "^2.7.5",
    "@angular/build": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@testing-library/dom": "^10.4.1",
    "ng-packagr": "^22.2.1",
    "rxjs": "^7.8.2"
  }
}
